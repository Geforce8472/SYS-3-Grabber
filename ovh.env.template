# Fill in your OVH token (https://eu.api.ovh.com/createToken/,
# rights: GET/POST/DELETE /order/*  and  GET /me/*), then save as ovh.env
# ovh.env is gitignored and Claude will never read it.
export OVH_APPLICATION_KEY=your_app_key
export OVH_APPLICATION_SECRET=your_app_secret
export OVH_CONSUMER_KEY=your_consumer_key
